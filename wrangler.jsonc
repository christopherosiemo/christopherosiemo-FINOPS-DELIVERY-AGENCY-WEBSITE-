{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hkgpipi-enquiry",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ENQUIRY_RATE_LIMITER", "class_name": "EnquiryRateLimiter" }
    ]
  },
  "exports": {
    "EnquiryRateLimiter": { "type": "durable-object", "storage": "sqlite" }
  },
  "send_email": [
    {
      "name": "ENQUIRY_EMAIL",
      "allowed_sender_addresses": ["enquiries@hkgpipi.com"]
    }
  ],
  "env": {
    "staging": {
      "name": "hkgpipi-enquiry-staging",
      "vars": {
        "APP_ENVIRONMENT": "staging",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEycsh73Xu_bnTgX",
        "TURNSTILE_EXPECTED_HOSTNAME": "hkgpipi-enquiry-staging.charltonyalazima.workers.dev"
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "durable_objects": {
        "bindings": [
          { "name": "ENQUIRY_RATE_LIMITER", "class_name": "EnquiryRateLimiter" }
        ]
      },
      "send_email": [
        {
          "name": "ENQUIRY_EMAIL",
          "allowed_sender_addresses": ["enquiries@hkgpipi.com"]
        }
      ]
    },
    "production": {
      "name": "hkgpipi-enquiry-production",
      "vars": {
        "APP_ENVIRONMENT": "production",
        "TURNSTILE_EXPECTED_HOSTNAME": "hkgpipi.com"
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "durable_objects": {
        "bindings": [
          { "name": "ENQUIRY_RATE_LIMITER", "class_name": "EnquiryRateLimiter" }
        ]
      },
      "send_email": [
        {
          "name": "ENQUIRY_EMAIL",
          "allowed_sender_addresses": ["enquiries@hkgpipi.com"]
        }
      ]
    }
  }
}
