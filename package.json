{
  "name": "finops-delivery-agency-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:engineering": "playwright test --config=playwright.engineering.config.ts",
    "test:performance": "node scripts/performance-audit.mjs --check",
    "test:qualification": "playwright test --config=playwright.qualification.config.ts",
    "test:acquisition": "playwright test --config=playwright.acquisition.config.ts",
    "evidence:acquisition": "node scripts/gate-9a-evidence.mjs",
    "evidence:qualification": "node scripts/gate-8b-evidence.mjs",
    "test:smoke:cross-browser": "playwright test --config=playwright.smoke.config.ts",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots=all",
    "dev:cf": "vinext dev --port 3001",
    "build:cf": "vinext build",
    "start:cf": "wrangler dev --config dist/server/wrangler.json",
    "deploy:cf": "vinext-cloudflare deploy",
    "test:cf": "vitest run --config vitest.cloudflare.config.ts",
    "types:cf": "wrangler types"
  },
  "engines": {
    "node": ">=22.0.0 <26"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@vinext/cloudflare": "1.0.0-beta.7",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/vitest-plugin": "1.1.8",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "27.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.0",
    "wrangler": "4.131.1"
  },
  "type": "module"
}
